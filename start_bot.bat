@echo off
chcp 65001 > nul
title بوت جامعة أهل الحديث الأكاديمي

echo ============================================================
echo      جامعة أهل الحديث - تشغيل وتحديث البوت الأكاديمي
echo ============================================================
echo.

echo [1/3] جاري فحص وبناء الكود البرمجي (npm run build)...
call npm run build
if %errorlevel% neq 0 (
    echo.
    echo [خطأ] فشل بناء المشروع! يرجى التأكد من عدم وجود أخطاء برمجية.
    pause
    exit /b %errorlevel%
)
echo [تم] تم بناء الكود بنجاح.
echo.

echo [2/3] جاري التحقق من اتصال قاعدة البيانات (Neon PostgreSQL)...
echo (البيانات متصلة سحابياً عبر رابط .env)
echo.

echo [3/3] جاري تشغيل خادم البوت...
echo ============================================================
echo  البوت قيد التشغيل الآن على تليجرام:
echo  t.me/Ahl_AlHadith_University_bot
echo.
echo  (لإيقاف البوت اضغط Ctrl + C)
echo ============================================================
echo.

call npm run start:dev

pause
